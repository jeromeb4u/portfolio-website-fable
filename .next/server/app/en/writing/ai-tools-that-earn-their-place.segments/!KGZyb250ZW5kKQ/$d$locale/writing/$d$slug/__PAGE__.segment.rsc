0:{"rsc":["$","$1","c",{"children":[["$","article",null,{"className":"pt-32","children":[["$","div",null,{"className":"container-site max-w-3xl","children":[["$","p",null,{"className":"mono-label text-ink-muted","children":["July 30, 2026"," · ",1," ","min read"]}],["$","$L2",null,{"as":"h1","variant":"clip","className":"mt-6 font-serif text-display text-ink","children":"AI features that earn their place in a small product"}],["$","$L2",null,{"as":"p","delay":0.15,"className":"mt-6 text-body-lg text-ink-muted","children":"Most \"add AI\" requests are really requests to remove a manual step. That reframing decides whether the feature is worth building."}]]}],null,["$","div",null,{"className":"container-site section-pad","children":["$","div",null,{"className":"prose-content space-y-6 text-ink [&_h2]:font-semibold [&_h2]:text-ink [&_h2]:mt-12 [&_h3]:font-semibold [&_img]:rounded-xl [&_a]:text-accent-strong [&_a]:underline-offset-4 hover:[&_a]:underline mx-auto max-w-3xl","children":["$","div",null,{"className":"payload-richtext","children":[["$","p","0",{"children":["Almost every AI request I get starts the same way: someone has seen a demo and wants one. The useful question is not which model to call — it is which manual step currently costs them an hour a week."]}],["$","p","1",{"children":["Once the question is framed that way, the design gets much smaller. A model that drafts the first version of something a human already writes every day is worth building. A model that invents content nobody asked for is a liability, because someone now has to check it."]}],["$","p","2",{"children":["The part that decides whether it ships is the failure mode. A drafting feature can be wrong and still be useful, because the human is already in the loop reviewing it. A feature that acts without review has to be right, and \"usually right\" is not a specification you can hand to a small business."]}],["$","p","3",{"children":["Practically, that means most of the engineering is not prompt work. It is the boring scaffolding: keeping the request cheap, caching what does not change, making the output editable, and leaving an obvious path back to doing it by hand when the model is unavailable."]}],["$","p","4",{"children":["The tools that stayed in use after a month were the ones where the person could see exactly what the model did and change it. The ones that got switched off were the ones that felt like a black box, regardless of how good the output was."]}]]}]}]}]]}],[["$","script","script-0",{"src":"/_next/static/chunks/138yfan2wekri.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"a4SVq7nYiyuXuOohuJWet"}
